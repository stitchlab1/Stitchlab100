{
  "name": "stitchlab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "vite build && esbuild src/server.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs --external:express --external:vite --external:@google/genai --external:dotenv",
    "lint": "tsc --noEmit",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@google/genai": "^2.8.0",
    "canvas-confetti": "^1.9.4",
    "dom-to-image": "^2.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "firebase": "^12.14.0",
    "lucide-react": "^0.546.0",
    "motion": "^14.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/dom-to-image": "^2.6.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vite": "^6.4.3"
  }
